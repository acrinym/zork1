{
  "timeout_seconds": 80,
  "allowed_exit_codes": [0],
  "close_stdin": false,
  "steps": [
    {"expect": "Release 1224"},
    {"sendline": "asetup"},
    {"expect": "ARCHIVE-SETUP:READY"},
    {"sendline": "examine catalog"},
    {"expect": "HOUSE-THRESHOLD-01"},
    {"sendline": "take gray folder"},
    {"expect": ">"},
    {"sendline": "read gray folder"},
    {"expect": "verified source"},
    {"sendline": "crossref gray folder"},
    {"expect": "VISIT-SURVEY"},
    {"sendline": "file gray folder"},
    {"expect": "no copy is created"},
    {"sendline": "play house cassette"},
    {"expect": "stops without changing any live object"},
    {"sendline": "areport"},
    {"expect": "ARCHIVE:VERSION=1;INDEXED=31;FILED=1;ANNOTATED=1;THRESHOLD=Y;DISPLAY=Y;DAM=Y;VISITOR=Y;CASSETTE=Y;THRESHOLD-CABINET=Y"},
    {"sendline": "save"},
    {"expect": "(?i)(file name|filename|saved game)"},
    {"sendline": "{ARCHIVE_SAVE_FILE}"},
    {"expect": ">"},
    {"sendline": "amutate"},
    {"expect": "ARCHIVE:MUTATED"},
    {"sendline": "areport"},
    {"expect": "ARCHIVE:VERSION=1;INDEXED=0;FILED=0;ANNOTATED=0;THRESHOLD=N;DISPLAY=N;DAM=N;VISITOR=N;CASSETTE=N;THRESHOLD-CABINET=N"},
    {"sendline": "restore"},
    {"expect": "(?i)(file name|filename|saved game)"},
    {"sendline": "{ARCHIVE_SAVE_FILE}"},
    {"expect": ">"},
    {"sendline": "areport"},
    {"expect": "ARCHIVE:VERSION=1;INDEXED=31;FILED=1;ANNOTATED=1;THRESHOLD=Y;DISPLAY=Y;DAM=Y;VISITOR=Y;CASSETTE=Y;THRESHOLD-CABINET=Y"},
    {"sendline": "quit"},
    {"expect": "(?i)(really|wish to leave|are you sure)"},
    {"sendline": "yes"},
    {"expect_eof": true}
  ]
}
