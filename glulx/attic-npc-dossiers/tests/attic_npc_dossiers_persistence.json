{
  "timeout_seconds": 80,
  "allowed_exit_codes": [0],
  "close_stdin": false,
  "steps": [
    {"expect": "Release 1225"},
    {"sendline": "nsetup"},
    {"expect": "NPC-SETUP:READY"},
    {"sendline": "examine catalog"},
    {"expect": "NPC-TROLL-01"},
    {"expect": "NPC-CYCLOPS-02"},
    {"expect": "NPC-THIEF-03"},
    {"sendline": "take green dossier"},
    {"expect": ">"},
    {"sendline": "review green dossier"},
    {"expect": "Passage status"},
    {"sendline": "crossref green dossier"},
    {"expect": "HOUSE-THRESHOLD-01"},
    {"sendline": "file green dossier"},
    {"expect": "No replacement, duplicate, or reconstructed property record"},
    {"sendline": "play encounter cassette"},
    {"expect": "No raw transcript"},
    {"sendline": "nreport"},
    {"expect": "NPC:VERSION=1;SEEN=15;TROLL=351;CYCLOPS=359;THIEF=495;FILED=1;TROLL=Y;CYCLOPS=Y;THIEF=Y;TIMELINE=Y;TROLL-CABINET=Y"},
    {"sendline": "save"},
    {"expect": "(?i)(file name|filename|saved game)"},
    {"sendline": "{NPC_SAVE_FILE}"},
    {"expect": ">"},
    {"sendline": "nmutate"},
    {"expect": "NPC:MUTATED"},
    {"sendline": "nreport"},
    {"expect": "NPC:VERSION=1;SEEN=0;TROLL=0;CYCLOPS=0;THIEF=0;FILED=0;TROLL=N;CYCLOPS=N;THIEF=N;TIMELINE=N;TROLL-CABINET=N"},
    {"sendline": "restore"},
    {"expect": "(?i)(file name|filename|saved game)"},
    {"sendline": "{NPC_SAVE_FILE}"},
    {"expect": ">"},
    {"sendline": "nreport"},
    {"expect": "NPC:VERSION=1;SEEN=15;TROLL=351;CYCLOPS=359;THIEF=495;FILED=1;TROLL=Y;CYCLOPS=Y;THIEF=Y;TIMELINE=Y;TROLL-CABINET=Y"},
    {"sendline": "quit"},
    {"expect": "(?i)(really|wish to leave|are you sure)"},
    {"sendline": "yes"},
    {"expect_eof": true}
  ]
}
