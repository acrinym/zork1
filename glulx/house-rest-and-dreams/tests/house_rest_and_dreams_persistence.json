{
  "timeout_seconds": 120,
  "allowed_exit_codes": [0],
  "close_stdin": false,
  "steps": [
    {"expect": "Release 1228"},
    {"sendline": "rsetup"},
    {"expect": "REST-SETUP:READY"},

    {"sendline": "sleep"},
    {"expect": "A measured knock reaches the upper floor"},
    {"sendline": "rreport"},
    {"expect": "REST:VERSION=1;CYCLES=0;LASTSIG=0;DREAMED=0;OVERNIGHT=98;FILED=0;STRENGTH=-2;STAGGERED=N;GARLIC=Y;NOTE=Y;REPORT=Y;REPORT-CABINET=Y;NOTICE=Y"},

    {"sendline": "sleep"},
    {"expect": "one step of your temporary combat injury"},
    {"expect": "garlic smell fades"},
    {"expect": "one more stair than you remember"},
    {"expect": "You wake in the Bedroom"},
    {"sendline": "rreport"},
    {"expect": "REST:VERSION=1;CYCLES=1;LASTSIG=33;DREAMED=1;OVERNIGHT=98;FILED=0;STRENGTH=-1;STAGGERED=N;GARLIC=N;NOTE=Y;REPORT=Y;REPORT-CABINET=Y;NOTICE=Y"},

    {"sendline": "sleep"},
    {"expect": "no new expedition evidence since the last full rest"},
    {"sendline": "rreport"},
    {"expect": "REST:VERSION=1;CYCLES=1;LASTSIG=33;DREAMED=1;OVERNIGHT=98;FILED=0;STRENGTH=-1;STAGGERED=N;GARLIC=N;NOTE=Y;REPORT=Y;REPORT-CABINET=Y;NOTICE=Y"},

    {"sendline": "rforest"},
    {"expect": "REST-DISCOVERY:FOREST"},
    {"sendline": "sleep"},
    {"expect": "one step of your temporary combat injury"},
    {"expect": "branches arranging themselves into only the paths you actually walked"},
    {"sendline": "rreport"},
    {"expect": "REST:VERSION=1;CYCLES=2;LASTSIG=35;DREAMED=3;OVERNIGHT=98;FILED=0;STRENGTH=0;STAGGERED=N;GARLIC=N;NOTE=Y;REPORT=Y;REPORT-CABINET=Y;NOTICE=Y"},

    {"sendline": "rdam"},
    {"expect": "REST-DISCOVERY:DAM"},
    {"sendline": "sleep"},
    {"expect": "relay clicks, wet concrete"},
    {"sendline": "rreport"},
    {"expect": "REST:VERSION=1;CYCLES=3;LASTSIG=39;DREAMED=7;OVERNIGHT=98;FILED=0;STRENGTH=0;STAGGERED=N;GARLIC=N;NOTE=Y;REPORT=Y;REPORT-CABINET=Y;NOTICE=Y"},

    {"sendline": "read dream notebook"},
    {"expect": "REST-DREAM-01"},
    {"expect": "House stair and return dream"},
    {"expect": "Earned forest-path dream"},
    {"expect": "Dam relay and wet-concrete dream"},
    {"expect": "REST-RECORD-INTEGRITY:PASS"},

    {"sendline": "rattic"},
    {"expect": "REST-TEST:ATTIC"},
    {"sendline": "examine catalog"},
    {"expect": "REST-DREAM-01"},
    {"expect": "REST-OVERNIGHT-02"},
    {"sendline": "take overnight report"},
    {"expect": "Taken"},
    {"sendline": "review overnight report"},
    {"expect": "REST-OVERNIGHT-02"},
    {"expect": "WAIT and Z remain ordinary canonical waiting"},
    {"expect": "REST-RECORD-INTEGRITY:PASS"},
    {"sendline": "file overnight report"},
    {"expect": "You file the exact Bedroom record"},
    {"sendline": "rreport"},
    {"expect": "REST:VERSION=1;CYCLES=3;LASTSIG=39;DREAMED=7;OVERNIGHT=98;FILED=2;STRENGTH=0;STAGGERED=N;GARLIC=N;NOTE=Y;REPORT=Y;REPORT-CABINET=Y;NOTICE=Y"},

    {"sendline": "save"},
    {"expect": "(?i)(file name|filename|saved game)"},
    {"sendline": "{REST_SAVE_FILE}"},
    {"expect": ">"},
    {"sendline": "rmutate"},
    {"expect": "REST:MUTATED"},
    {"expect": "REST:VERSION=1;CYCLES=0;LASTSIG=0;DREAMED=0;OVERNIGHT=0;FILED=0;STRENGTH=-5;STAGGERED=Y;GARLIC=Y;NOTE=N;REPORT=N;REPORT-CABINET=N;NOTICE=N"},

    {"sendline": "restore"},
    {"expect": "(?i)(file name|filename|saved game)"},
    {"sendline": "{REST_SAVE_FILE}"},
    {"expect": ">"},
    {"sendline": "rreport"},
    {"expect": "REST:VERSION=1;CYCLES=3;LASTSIG=39;DREAMED=7;OVERNIGHT=98;FILED=2;STRENGTH=0;STAGGERED=N;GARLIC=N;NOTE=Y;REPORT=Y;REPORT-CABINET=Y;NOTICE=Y"},
    {"sendline": "review overnight report"},
    {"expect": "REST-OVERNIGHT-02"},
    {"expect": "REST-RECORD-INTEGRITY:PASS"},

    {"sendline": "quit"},
    {"expect": "(?i)(really|wish to leave|are you sure)"},
    {"sendline": "yes"},
    {"expect_eof": true}
  ]
}
