{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acrinym.github.io/zork1/infocom-corpus/style-receipt.schema.json",
  "title": "Highly Extended Zork style receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "surface_family", "candidate", "authority_profile", "primary_authorities", "excluded_voices", "retained_linguistic_traits", "intentional_departures", "originality_check", "reviewed_by", "reviewed_on"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "surface_family": {"type": "string", "minLength": 1},
    "candidate": {
      "type": "object",
      "required": ["path", "sha256", "word_count"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "word_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "authority_profile": {"type": "string", "minLength": 1},
    "primary_authorities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "secondary_authorities": {"type": "array", "items": {"type": "string"}},
    "excluded_voices": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "retained_linguistic_traits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "intentional_departures": {"type": "array", "items": {"type": "string"}},
    "originality_check": {
      "type": "object",
      "required": ["corpus_digest", "candidate_sha256", "longest_source_overlap_tokens", "rare_phrase_match_count", "thresholds", "passed", "source_text_disclosed"],
      "properties": {
        "corpus_digest": {"type": "string"},
        "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "longest_source_overlap_tokens": {"type": "integer", "minimum": 0},
        "rare_phrase_match_count": {"type": "integer", "minimum": 0},
        "thresholds": {"type": "object"},
        "passed": {"const": true},
        "source_text_disclosed": {"const": false}
      },
      "additionalProperties": false
    },
    "reviewed_by": {"type": "string", "minLength": 1},
    "reviewed_on": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
